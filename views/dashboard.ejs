<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gooble Drive - <%= title %></title>
  <link rel="stylesheet" href="/style.css"> 
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  </head>
<body class="dashboard-layout">

  <%- include('partials/header') %>
  <%- include('partials/sidebar') %>
  <%- include('partials/upload-modal.ejs') %>
  <%- include('partials/options-menu.ejs') %>
  <%- include('partials/share-modal.ejs') %>
  <%- include('partials/move-modal.ejs') %>
  <%- include('partials/log-out-modal.ejs') %>

  <% if (viewMode !== 'recent') { %>
    <%- include('partials/add-btn.ejs') %>
  <% } %>

  <!-- Main Content Area -->
  <main class="app-main">
    <% if (viewMode === 'dashboard') { %>
      <%- include('partials/dashboard-window.ejs') %>
    <% } else if (viewMode === 'recent') { %>
      <%- include('partials/recent-window.ejs') %>
    <% } else if (viewMode === 'starred') { %>
      <%- include('partials/starred-window.ejs') %>
    <% } %>
  </main>
  
  <!-- Details Modal Pane -->
  <%- include('partials/details-modal.ejs') %>
  
  <script>

    // === DOM ELEMENTS ===
    const dom = {
    layout: document.querySelector('.dashboard-layout'),
    header: {
      searchbar: document.querySelector('.search-bar'),
      searchInput: document.getElementById('searchInput'),
      searchResults: document.getElementById('searchResults'),
      avatar: document.querySelector('.avatar')
    },
    grid: document.querySelector('.item-grid'),
    modals: {
      upload: document.getElementById('uploadModal'),
      details: document.getElementById('detailsModal'),
      share: document.getElementById('shareModal'),
      move: document.getElementById('moveModal'),
      logout: document.getElementById('logoutModal')
    },
    upload: {
      fileInput: document.getElementById('file'),
    },
    details: {
      name: document.getElementById('detailName'),
      type: document.getElementById('detailType'),
      size: document.getElementById('detailSize'),
      date: document.getElementById('detailDate')
    },
    share: {
      setup: document.getElementById('shareSetup'),
      result: document.getElementById('shareResult'),
      itemId: document.getElementById('shareItemId'),
      itemType: document.getElementById('shareItemType'),
      duration: document.getElementById('shareDuration'),
      linkInput: document.getElementById('generatedLink')
    },
    options: {
      menu: document.getElementById('optionsMenu'),
      details: document.getElementById('optionsDetailsBtn'),
      download: document.getElementById('optionsDlBtn'),
      share: document.getElementById('optionsShareBtn'),
      delete: document.getElementById('optionsDeleteBtn'),
      rename: document.getElementById('optionsRenameBtn'),
      copy: document.getElementById('optionsCopyBtn'),
      move: document.getElementById('optionsMoveBtn'),
    },
  };

  // === VISIBILITY TOGGLE HELPER ===
  const toggleUI = (el, force) => {
    const isActive = el.classList.toggle('active', force);

    if (el?.classList?.contains('modal-overlay')) {
      document.body.classList.toggle('modal-open', isActive);
    }

    return isActive;
  };


  // === SEARCH FUNCTIONALITY ===
  let debounceTimer;

  if (dom.header.searchInput) {
    dom.header.searchInput.addEventListener('input', (e) => {
      clearTimeout(debounceTimer); // Clear previous timer on each input
      const query = e.target.value.trim();

      // If query is too short, hide results and skip API call
      if (query.length < 2) {
        dom.header.searchResults.innerHTML = '';
        dom.header.searchResults.style.display = 'none';
        return;
      }

      // Add wait timer after user stops typing
      debounceTimer = setTimeout(async () => {
        try {
          const response = await fetch(`/dashboard/api/search?q=${encodeURIComponent(query)}`);
          const data = await response.json();

          renderSearchResults(data);
        } catch (err) {
          console.error("Search error:", err);
        }
      }, 300); // Debounce delay
    });
  }

  function renderSearchResults(data) {
    dom.header.searchResults.innerHTML = ''; // Clear old results

    if (data.files.length === 0 && data.folders.length === 0) {
      dom.header.searchResults.innerHTML = '<div style="padding: 10px; color: #666;">No results found.</div>';
      dom.header.searchResults.style.display = 'block';
      return;
    }

    // Helper function to build result items
    const buildItem = (item, type) => {
      const div = document.createElement('div');
      div.classList.add('search-result');
      
      // Clicking takes them to the directory
      const targetUrl = item.folderId 
        ? `/dashboard/${item.folderId}` // It's a file inside a folder
        : (type === 'folder' ? `/dashboard/${item.id}` : `/dashboard`); // It's a folder, or a file in the root

      div.innerHTML = `
        <strong>${type === 'folder' ? '📁' : '📄'} ${item.name}</strong>
        ${item.folder ? `<br><small style="color: #888;">in ${item.folder.name}</small>` : ''}
      `;

      // Navigate on click
      div.addEventListener('click', () => {
        window.location.href = targetUrl;
      });

      // // Simple hover effect
      // div.addEventListener('mouseenter', () => div.style.backgroundColor = '#f5f5f5');
      // div.addEventListener('mouseleave', () => div.style.backgroundColor = 'white');

      return div;
    };

    data.folders.forEach(folder => dom.header.searchResults.appendChild(buildItem(folder, 'folder')));
    data.files.forEach(file => dom.header.searchResults.appendChild(buildItem(file, 'file')));

    dom.header.searchResults.style.display = 'block';
  }


  // Close search dropdown if user clicks outside of it
  document.addEventListener('click', (e) => {
    if (dom.header.searchInput && !dom.header.searchInput.contains(e.target) && !dom.header.searchResults.contains(e.target)) {
      dom.header.searchResults.style.display = 'none';
    }
  });


  // === LOGOUT MODAL ===
  dom.header.avatar?.addEventListener('click', () => {
    toggleUI(dom.modals.logout, true);
  })

  // === GRID ITEM BEHAVIOR ===

  const syncDetailsPane = (item) => {
    // Populate Details Pane
    dom.details.name.textContent = item.dataset.name;
    dom.details.type.textContent = item.dataset.type;
    dom.details.size.textContent = item.dataset.size;
    dom.details.date.textContent = item.dataset.date;
  }

  dom.grid?.addEventListener('click', (e) => {
    const item = e.target.closest('.grid-item');
    if (!item) return;

    // FIX: "Stop" navigation on single click for folders
    if (item.tagName === 'A') e.preventDefault();

    syncDetailsPane(item);
  });

  // Double click allows navigating into a folder
  dom.grid?.addEventListener('dblclick', (e) => {
    const item = e.target.closest('.grid-item');

    if (!item) return;

    const itemType = item.dataset.type;

    if (itemType === 'folder') {
      const destination = item?.getAttribute('href');
      // "Go" navigation on double click
      if (destination) window.location.href = destination;
    
    // Open files in a new tab
    } else if (itemType === 'file') {
      const fileUrl = item.dataset.url;

      if (fileUrl) {
      // open(url, target) where '_blank' opens a new tab
      window.open(fileUrl, '_blank');
      }
    }
  });

  // === OPTIONS MENU LOGIC ===
  const showOptionsMenu = (e) => {
    const item = e.target.closest('.grid-item');
    const itemId = item.dataset.id;
    const itemType = item.dataset.type;
    const itemName = item.dataset.name;
    const parentFolder = item.dataset.parentId;
    
    syncDetailsPane(item);

    e.preventDefault();
    e.stopPropagation();

    // Stamp ID onto options menu
    dom.options.menu.dataset.activeId = itemId;
    dom.options.menu.dataset.activeType = itemType;
    dom.options.menu.dataset.activeName = itemName;
    dom.options.menu.dataset.parentFolder = parentFolder;

    // Update Menu Buttons
    dom.options.download.href = `/download/${itemId}`;

    // Position and Show
    dom.options.menu.style.top = `${e.pageY}px`;
    dom.options.menu.style.left = `${e.pageX}px`;
    toggleUI(dom.options.menu, true);
  };

  document.querySelectorAll('.options-btn').forEach(btn => 
    btn.addEventListener('click', showOptionsMenu)
  );

  // === VIEW DETAILS ===
  dom.options.details.addEventListener('click', () => {
    dom.layout.classList.add('show-details');
    toggleUI(dom.options.menu, false);
  })

  // === SHARE FEATURE (Fetch API) ===
  const openShareModal = (itemId, itemType) => {
    dom.share.itemId.value = itemId;
    dom.share.itemType.value = itemType;
    toggleUI(dom.modals.share, true);
  };

  dom.options.share?.addEventListener('click', () => {
    dom.options.menu.classList.remove('active');
    const itemId = dom.options.menu.dataset.activeId;
    const itemType = dom.options.menu.dataset.activeType;
    openShareModal(itemId, itemType);
  });

  async function handleShareClick() {
    // payload = file to share's id and selected duration
    const payload = {
      itemId: dom.share.itemId.value,
      itemType: dom.share.itemType.value,
      duration: dom.share.duration.value
    };

    try {
      const response = await fetch('/share', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await response.json();

      if (data.shareLink) {
        dom.share.linkInput.value = data.shareLink;
      }
    } catch (err) {
      console.error("Share failed", err);
      alert("Could not generate link.");
    }
  }

  async function copyGeneratedLink() {
    await navigator.clipboard.writeText(dom.share.linkInput.value);
    alert("Link copied to clipboard!");
  }


  // === RENAME FILE/FOLDER LOGIC ===
  dom.options.rename.addEventListener('click', async () => {
    const id = dom.options.menu.dataset.activeId;
    const type = dom.options.menu.dataset.activeType;
    
    // Quick way to get the existing name from the dashboard UI
    const itemElement = document.querySelector(`.grid-item[data-id="${id}"][data-type="${type}"]`);
    
    if (!itemElement) return console.error("Could not find element to rename");
    
    const oldName = itemElement.querySelector('.item-name').innerText;
    const newName = prompt(`Enter new name for this ${type}:`, oldName);

    if (newName && newName !== oldName) {
      const response = await fetch(`/${type}s/${id}/rename`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ newName })
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert(`Could not rename ${type}. Please try again.`);
      }
    }
  });


  // === DELETE FILE/FOLDER LOGIC ===
  dom.options.delete.addEventListener('click', async () => {
    const itemId = dom.options.menu.dataset.activeId;
    const itemType = dom.options.menu.dataset.activeType;
    
    const confirmDelete = confirm(`Are you sure you want to delete this ${itemType}?`);
    if (!confirmDelete) return;

    try {
      // Determine route based on type
      const route = `/${itemType}s/${itemId}/delete`;
      
      const response = await fetch(route, { method: 'DELETE' });
      // Holds json object containing success status after calling deleteFile
      const result = await response.json();


      if (result.success) {
        window.location.reload(); // Refresh to update grid
      } else {
        alert("Error deleting item.");
      }
    } catch (err) {
      console.error("Delete failed:", err);
    }
  });


  // === MOVE FILE/FOLDER LOGIC ===
  const moveForm = document.getElementById('moveForm');
  const folderSelect = document.getElementById('folderSelect');

  dom.options.move.addEventListener('click', async () => {
    dom.options.menu.classList.remove('active');
    const id = dom.options.menu.dataset.activeId;
    const type = dom.options.menu.dataset.activeType;
    const name = dom.options.menu.dataset.activeName;
    const currentParentFolder = dom.options.menu.dataset.parentFolder;
    const moveFolderName = document.getElementById('moveFolderName');
    const moveFileName = document.getElementById('moveFileName');

    // Pass active info to the server
    const response = await fetch(`/folders?movingId=${id}&type=${type}`);
    const folders = await response.json();

    // 'Reset'/'Clear' options except root folder
    folderSelect.innerHTML = `
    <option value="" disabled selected>— Select Destination —</option>
    <option value="root" id="moveRoot">My Drive (Root)</option>
    `;
    const rootOption = document.getElementById('moveRoot');

    // PRE-CHECK: If parent folder is root, disable the Root option
    if (currentParentFolder === '') {
      rootOption.disabled = true;
      rootOption.textContent += ' (current location)';
      rootOption.style.color = '#999';
    }
    
    // Display possible folder destinations
    folders.forEach(folder => {
      const option = document.createElement('option');
      option.value = folder.id;
      option.textContent = folder.name;

      if (folder.isInvalid) {
        option.disabled = true;
        if (folder.id === parseInt(id)) {
          option.textContent += ' (cannot move into self)';
        } else {
          option.textContent += ' (cannot move into sub-nested folder)';
        }

        option.style.color = '#999'; // visual grey out

      // If current location folder, already in folder
      } else if (folder.id == currentParentFolder) {
        option.disabled = true;
        option.textContent += ' (current location)';
        option.style.color = '#999';
      }

      folderSelect.appendChild(option);
    });

    document.getElementById('moveItemType').textContent = type;
    if (type === 'folder') {
      moveFolderName.style.display = 'block';
      moveFolderName.textContent += `${name}`;
    } else {
      moveFileName.style.display = 'block';
      moveFileName.textContent += `${name}`;
    }
    dom.modals.move.classList.add('active');
  });


  // Submitting destination folder for Move
  moveForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = dom.options.menu.dataset.activeId;
    const type = dom.options.menu.dataset.activeType;
    const destinationId = folderSelect.value;

    // Guard against immediate submission; if value is empty, no destination folder selected
    if (!destinationId) {
      alert("Please select a destination folder.");
      return;
    }

    const response = await fetch (`/${type}s/${id}/move`, {
      method: 'PATCH',
      headers: { 'Content-type': 'application/json' },
      body: JSON.stringify({ destinationId })
    });

    if (response.ok) {
      window.location.reload();
    } else {
      const err = await response.json();
      alert(err.error || 'Move failed.');
    }
  });


  // === COPY FILES/FOLDERS LOGIC ===
  dom.options.copy.addEventListener('click', async () => {
    const id = dom.options.menu.dataset.activeId;
    if (!id) return;

    let response;
    try {
      if (dom.options.menu.dataset.activeType === 'folder') {
        const confirmCopy = confirm("Copying a folder will also copy all of its contents. Do you want to proceed?");
        
        if (!confirmCopy) return;

        response = await fetch(`/folders/${id}/copy`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
      }
      
      if (dom.options.menu.dataset.activeType === 'file') {
         const confirmCopy = confirm("Do you want to make a copy of this file?");
        
        if (!confirmCopy) return;

        response = await fetch(`/files/${id}/copy`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
      }

      const result = await response.json();
      
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.error || "Failed to copy item.");
      }
    } catch (err) {
      console.error("Error with copy operation:", err);
    } finally {
      toggleUI(dom.options.menu, false);
    }
  })


  // === STAR/UNSTAR LOGIC ===
  document.querySelectorAll('.star-toggle-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation(); // Prevent triggering other click events (like opening options menu)
      const itemId = btn.dataset.id;
      const itemType = btn.dataset.type;
      const isStarred = btn.dataset.starred === 'true';

      try {
        const response = await fetch(`/${itemType}s/${itemId}/star`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ isStarred: !isStarred,
            itemType: itemType
          }) // Toggle star status
        });

        if (response.ok) {
          // Optimistically toggle star in UI
          const icon = btn.querySelector('.icon');
          if (icon.classList.contains('hollow-star')) {
            icon.classList.remove('hollow-star');
            icon.classList.add('filled-star');
            icon.textContent = '★';
          } else {
            icon.classList.remove('filled-star');
            icon.classList.add('hollow-star');
            icon.textContent = '☆';
          }
        } else {
          alert("Failed to update star status.");
        }
      } catch (err) {
        console.error("Error toggling star:", err);
      }
    });
  });

  // === UPLOAD MODAL ===
  const openUploadModal = () => toggleUI(dom.modals.upload, true);
  const tabUpload = document.getElementById('tabUpload');
  const tabFolder = document.getElementById('tabFolder');
  const formUpload = document.getElementById('formUploadCont');
  const formFolder = document.getElementById('formFolderCont');
  document.getElementById('openUploadModal')?.addEventListener('click', openUploadModal);
  document.querySelector('.empty-upload-btn')?.addEventListener('click', openUploadModal);

  // Add alert for file sizes larger than 10MB OR Invalid File Type
  const allowedFileTypes = ['image/jpeg', 'image/png', 'application/pdf', 'text/plain'];

  dom.upload.fileInput.addEventListener('change', (e) => {
    const file = e.target.files[0];

    if (file) {
      if (file.size > 10 * 1024 * 1024) {
        alert('This file is too large to upload (Max 10MB).');
        e.target.value = ""; // Clear the upload input
      }

      if (!allowedFileTypes.includes(file.type)) {
        alert('Invalid File Type. Must be .jpg, .png, .pdf, or .txt');
        e.target.value = ""; // Clear the upload input
      }
    }}
  );

  // Tab Switching Helper
  const switchTab = (activeTab, inactiveTab, showForm, hideForm) => {
    activeTab.classList.add('active');
    activeTab.classList.remove('inactive');
    inactiveTab.classList.add('inactive');
    inactiveTab.classList.remove('active');
    showForm.style.display = 'block';
    hideForm.style.display = 'none';
  };

  tabUpload.addEventListener('click', () => {
    switchTab(tabUpload, tabFolder, formUpload, formFolder);
  });

  tabFolder.addEventListener('click', () => {
    switchTab(tabFolder, tabUpload, formFolder, formUpload);
  });

  // === GLOBAL CLOSING LOGIC ===
  window.addEventListener('click', (e) => {
    // Close modals if dark overlay is clicked
    if (e.target === dom.modals.upload) toggleUI(dom.modals.upload, false);
    if (e.target === dom.modals.share) toggleUI(dom.modals.share, false);
    if (e.target === dom.modals.move) toggleUI(dom.modals.move, false);

    // Close options menu if clicking outside
    if (dom.options.menu.classList.contains('active') && !dom.options.menu.contains(e.target)) {
      dom.options.menu.classList.remove('active');
    }

    // Close details pane if clicking empty grid space
    if (dom.layout.classList.contains('show-details') && (e.target === dom.grid || e.target === document.querySelector('.app-main'))) {
      dom.layout.classList.remove('show-details');
    }
  });

  // Explicit close buttons
  const hideAllModals = () => {
    // Object.values selects all modals, .forEach modal attaches toggle
    Object.values(dom.modals).forEach(modal => toggleUI(modal, false));
    dom.options.menu.classList.remove('active');
    dom.layout.classList.remove('show-details');
  };

  document.querySelectorAll('.close-modal, #closeDetails, #closeUploadModal, #closeMoveModal, #closeShareModal').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      hideAllModals();
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideAllModals();
  });

  // --- SIDEBAR TREE LOGIC ---
  // Root 'Folders' Header Toggle
  const rootFolderBtn = document.getElementById('root-folder-btn');
  const mainFolderTree = document.getElementById('main-folder-tree');

  if (rootFolderBtn) {
    rootFolderBtn.addEventListener('click', () => {
      mainFolderTree.classList.toggle('hidden');
    });
  }

  // Single-Click: Expand/Collapse Nested Folders
  document.addEventListener('click', (e) => {
    const treeItem = e.target.closest('.tree-item');
    if (treeItem) {
      const folderId = treeItem.getAttribute('data-folder-id');
      const nestedTree = document.getElementById(`nested-${folderId}`);
      const caret = treeItem.querySelector('.caret-icon');

      // If it has a nested tree, toggle its visibility
      if (nestedTree) {
        nestedTree.classList.toggle('show-node');
        if (caret) caret.classList.toggle('open');
      }
    }
  });

  // Double-Click: Navigate into Folder
  document.addEventListener('dblclick', (e) => {
    const treeItem = e.target.closest('.tree-item');
    if (treeItem) {
      // Prevent the default browser text-highlighting that happens on double-click
      e.preventDefault(); 
      
      const folderId = treeItem.getAttribute('data-folder-id');
      // Immediately redirect the user to the folder
      window.location.href = `/dashboard/${folderId}`;
    }
  });

    // === MOBILE SIDEBAR TOGGLE ===
  const sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
  const appSidebar = document.getElementById('appSidebar');
  const sidebarOverlay = document.getElementById('sidebarOverlay');

  function openSidebar() {
    appSidebar?.classList.add('open');
    sidebarOverlay?.classList.add('active');
    document.body.classList.add('modal-open');
  }

  function closeSidebar() {
    appSidebar?.classList.remove('open');
    sidebarOverlay?.classList.remove('active');
    document.body.classList.remove('modal-open');
  }

  sidebarToggleBtn?.addEventListener('click', () => {
    appSidebar?.classList.contains('open') ? closeSidebar() : openSidebar();
  });

  sidebarOverlay?.addEventListener('click', closeSidebar);

  // Close sidebar when a nav link is tapped on mobile
  document.querySelectorAll('.nav-item').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 767) closeSidebar();
    });
  });

  </script>
  <% if (showTutorial) { %>
  <%- include('partials/tutorial-modal.ejs') %>
    <script src="/scripts/tutorial.js"></script>
  <% } %>
</body>
</html>