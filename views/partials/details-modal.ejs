<div id="detailsModal" class="modal-pane modal">
    <div class="details-cont"> 
        <div class="details-header">
          <h3><i class="ph-duotone ph-info"></i> Item Details</h3>
          <button id="closeDetails" class="close-details-btn" aria-label="Close details"><i class="ph-duotone ph-x"></i></button>
        </div>
        <div class="details-group">
            <p class="details-label">Name</p>
            <p id="detailName" class="details-data"></p>
        </div>
        <div class="details-group">
            <p class="details-label">Type</p>
            <p id="detailType" class="details-data"></p>
        </div>
        <div class="details-group">
            <p class="details-label">Size</p>
            <p id="detailSize" class="details-data"></p>
        </div>
        <div class="details-group">
            <p class="details-label">Created</p>
            <p id="detailDate" class="details-data"></p>
        </div>
    </div>
</div>