<!-- FILE GRID ITEM -->

<div 
  class="grid-item"
  data-type="file"
  data-id="<%= file.id %>"
  data-name="<%= file.name %>"
  data-url="<%= file.url%>"
  data-size="<%= (file.size / 1024).toFixed(1) %> KB" 
  data-date="<%= file.uploadTime.toDateString() %>"
  data-parent-id="<%= file.folderId || '' %>">
  <button class="options-btn">&#8942;</button>
  <div class="file-icon" style="font-size: 2rem;">📄</div>
  <div class="file-info">
    <% const ext=file.name.slice(file.name.lastIndexOf('.')); const baseName=file.name.replace(ext, '' ); %>
      <div class="item-name">
        <%= baseName %>
      </div>
      <div class="file-ext">
        <%= ext.toUpperCase().replace('.', '' ) %>
      </div>
      <div class="item-size" style="font-size: 0.8rem; color: var(--text-muted);">
        <%= (file.size / 1024).toFixed(1) %> KB
      </div>
  </div>
  <% if (viewMode === 'recent') { %>
    <a href="/dashboard/<%= file.folder ? file.folder.id : ''%>">📁 <span class="recent-folder-link"><%= file.folder ? file.folder.name : 'My Drive'%></span></a>
  <% } %>
  <button class="star-toggle-btn" data-id="<%= file.id %>" data-type="file" data-starred="<%= file.isStarred %>">
    <% if (file.isStarred) { %>
      <span class="icon filled-star">★</span> 
    <% } else { %>
      <span class="icon hollow-star">☆</span> 
    <% } %>
  </button>
</div>