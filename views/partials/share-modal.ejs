<div id="shareModal" class="modal-overlay modal">
  <div class="modal-content"> 
    <h3><i class="ph-duotone ph-share-network"></i> Share File</h3>
    
    <div id="shareSetup" class="modal-section">
      <input type="hidden" id="shareItemId">
      <input type="hidden" id="shareItemType" value="file">
      
      <label for="shareDuration">Link Duration:</label>
      <select id="shareDuration">
        <option value="3600000">1 Hour</option>
        <option value="86400000" selected>1 Day</option>
        <option value="604800000">1 Week</option>
      </select>
      
      <div class="modal-buttons"> 
        <button class="btn-primary" onclick="handleShareClick()"><i class="ph-duotone ph-link"></i> Generate Link</button>
      </div>
    </div>

    <div id="shareResult" class="modal-section">
      <p>Your shareable link is ready:</p>
      <div class="link-copy-box">
        <input type="text" id="generatedLink" readonly>
        <button class="btn-primary" onclick="copyGeneratedLink()"><i class="ph-duotone ph-copy"></i> Copy Link</button>
      </div>
      <button class="btn-secondary" id="closeShareModal">Close</button>
    </div>
  </div>
</div>