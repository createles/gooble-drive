<!-- Clickable Navigation Breadcrumbs -->
<div class="breadcrumbs">
  <a href="/dashboard" class="breadcrumb-link"><i class="ph-duotone ph-hard-drive"></i> My Drive</a>

  <% if (currentFolder) { %>
    <span class="breadcrumb-separator"><i class="ph-duotone ph-caret-right"></i></span>
    <a href="/dashboard/<%= currentFolder.id %>" class="breadcrumb-link">
      <%= currentFolder.name %>
    </a>
  <% } %>
</div>

<!-- Conditional Rendering based on database contents -->
<% if ((locals.folders && folders.length > 0) || (locals.files && files.length > 0)) { %>

  <div class="item-grid">
    <!-- Loop over folders -->
    <% folders.forEach(folder=> { %>
      <%- include('folder-item.ejs', { folder }) %>
    <% }) %>

    <!-- Loop over files -->
    <% files.forEach(file=> { %>
      <%- include('file-item.ejs', { file }) %>
    <% }) %>
  </div>

<% } else { %>

    <!-- Empty State -->
    <div class="empty-state">
      <div class="empty-state-content">
        <i class="ph-duotone ph-cloud-arrow-up empty-icon"></i>
        <p>This directory is currently empty.</p>
        <button class="btn-primary empty-upload-btn"><i class="ph-duotone ph-upload-simple"></i> Upload a File or Folder</button>
      </div>
    </div>

<% } %>