<!-- FOLDER GRID ITEM -->

<a 
  href="/dashboard/<%= folder.id %>"
  class="grid-item" data-type="folder" 
  data-id="<%= folder.id %>"
  data-name="<%= folder.name %>" 
  data-size="===" 
  data-date="<%= folder.createdOn.toDateString() %>"
  data-parent-id="<%= folder.parentId || '' %>">
  <button class="options-btn">&#8942;</button>
  <div class="folder-icon" style="font-size: 2rem;">📁</div>
  <div class="item-name">
    <%= folder.name %>
  </div>
  <button class="star-toggle-btn" data-id="<%= folder.id %>" data-type="folder" data-starred="<%= folder.isStarred %>">
    <% if (folder.isStarred) { %>
      <span class="icon filled-star">★</span> 
    <% } else { %>
      <span class="icon hollow-star">☆</span> 
    <% } %>
  </button>
</a>