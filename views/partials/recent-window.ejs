<!-- A link will not be clickable -->
<div class="breadcrumbs">
  <a href="" class="breadcrumb-link"">Recent Activity</a>
</div>

<!-- Conditional Rendering based on database contents -->
<% if (categorizedFiles && Object.keys(categorizedFiles).length !== 0) { %>

  <div class="item-grid" data-current-folder-id="<%= currentFolder ? currentFolder.id : 'root' %>">
        <!-- Loop over files, sectioned by activity date -->
          <h3> Today </h3>
            <% categorizedFiles.today.forEach(file=> { %>
              <div class="grid-item" data-type="file" data-id="<%= file.id %>" data-name="<%= file.name %>"
                data-size="<%= (file.size / 1024).toFixed(1) %> KB" data-date="<%= file.uploadTime.toDateString() %>">
                <button class="options-btn">&#8942;</button>
                <div class="file-icon" style="font-size: 2rem;">📄</div>
                <div class="file-info">
                  <% const ext=file.name.slice(file.name.lastIndexOf('.')); const baseName=file.name.replace(ext, '' ); %>
                    <div class="item-name">
                      <%= baseName %>
                    </div>
                    <div class="file-ext">
                      <%= ext.toUpperCase().replace('.', '' ) %>
                    </div>
                    <div class="item-size" style="font-size: 0.8rem; color: var(--text-muted);">
                      <%= (file.size / 1024).toFixed(1) %> KB
                    </div>
                </div>
              </div>
            <% }) %>
          <h3> In the past week </h3>
            <% categorizedFiles.pastWeek.forEach(file=> { %>
              <div class="grid-item" data-type="file" data-id="<%= file.id %>" data-name="<%= file.name %>"
                data-size="<%= (file.size / 1024).toFixed(1) %> KB" data-date="<%= file.uploadTime.toDateString() %>">
                <button class="options-btn">&#8942;</button>
                <div class="file-icon" style="font-size: 2rem;">📄</div>
                <div class="file-info">
                  <% const ext=file.name.slice(file.name.lastIndexOf('.')); const baseName=file.name.replace(ext, '' ); %>
                    <div class="item-name">
                      <%= baseName %>
                    </div>
                    <div class="file-ext">
                      <%= ext.toUpperCase().replace('.', '' ) %>
                    </div>
                    <div class="item-size" style="font-size: 0.8rem; color: var(--text-muted);">
                      <%= (file.size / 1024).toFixed(1) %> KB
                    </div>
                </div>
              </div>
            <% }) %>
          <h3> In the past month </h3>
            <% categorizedFiles.pastMonth.forEach(file=> { %>
              <div class="grid-item" data-type="file" data-id="<%= file.id %>" data-name="<%= file.name %>"
                data-size="<%= (file.size / 1024).toFixed(1) %> KB" data-date="<%= file.uploadTime.toDateString() %>">
                <button class="options-btn">&#8942;</button>
                <div class="file-icon" style="font-size: 2rem;">📄</div>
                <div class="file-info">
                  <% const ext=file.name.slice(file.name.lastIndexOf('.')); const baseName=file.name.replace(ext, '' ); %>
                    <div class="item-name">
                      <%= baseName %>
                    </div>
                    <div class="file-ext">
                      <%= ext.toUpperCase().replace('.', '' ) %>
                    </div>
                    <div class="item-size" style="font-size: 0.8rem; color: var(--text-muted);">
                      <%= (file.size / 1024).toFixed(1) %> KB
                    </div>
                </div>
              </div>
            <% }) %>
  </div>

<% } else { %>

    <!-- Empty State -->
    <div class="empty-state">
      <div class="empty-state-content">
        <p>No recent activity.</p>
      </div>
    </div>

<% } %>