<!-- A link will not be clickable -->
<div class="breadcrumbs">
  <a href="" class="breadcrumb-link"">Recent Activity</a>
</div>

<!-- Conditional Rendering based on database contents -->
<% if (categorizedFiles && Object.keys(categorizedFiles).length > 0) { %>

  <div class="item-grid">
        <!-- Loop over files, sectioned by activity date -->
         <% if (categorizedFiles.today.length > 0) { %>
          <h3 class="grid-section-header"> Today </h3>
            <% categorizedFiles.today.forEach(file=> { %>
              <%- include('file-item.ejs', { file }) %>
            <% }) %>
          <% } %>

          <% if (categorizedFiles.pastWeek.length > 0) { %>
          <h3 class="grid-section-header"> In the past week </h3>
            <% categorizedFiles.pastWeek.forEach(file=> { %>
              <%- include('file-item.ejs', { file }) %>
            <% }) %>
          <% } %>

          <% if (categorizedFiles.pastMonth.length > 0) { %>
          <h3 class="grid-section-header"> In the past month </h3>
            <% categorizedFiles.pastMonth.forEach(file=> { %>
              <%- include('file-item.ejs', { file }) %>
            <% }) %>
          <% } %>
  </div>

<% } else { %>

    <!-- Empty State -->
    <div class="empty-state">
      <div class="empty-state-content">
        <p>No recent activity.</p>
      </div>
    </div>

<% } %>