<div class="breadcrumbs">
  <a href="/dashboard/recent" class="breadcrumb-link"><i class="ph-duotone ph-clock-counter-clockwise"></i> Recent Activity</a>
</div>

<!-- Conditional Rendering based on database contents -->
<% if (categorizedFiles && Object.keys(categorizedFiles).length > 0) { %>

  <div class="item-grid">
        <!-- Loop over files, sectioned by activity date -->
         <% if (categorizedFiles.today && categorizedFiles.today.length > 0) { %>
          <h3 class="grid-section-header"><i class="ph-duotone ph-calendar-check"></i> Today</h3>
            <% categorizedFiles.today.forEach(file=> { %>
              <%- include('file-item.ejs', { file }) %>
            <% }) %>
          <% } %>

          <% if (categorizedFiles.pastWeek && categorizedFiles.pastWeek.length > 0) { %>
          <h3 class="grid-section-header"><i class="ph-duotone ph-calendar-blank"></i> In the past week</h3>
            <% categorizedFiles.pastWeek.forEach(file=> { %>
              <%- include('file-item.ejs', { file }) %>
            <% }) %>
          <% } %>

          <% if (categorizedFiles.pastMonth && categorizedFiles.pastMonth.length > 0) { %>
          <h3 class="grid-section-header"><i class="ph-duotone ph-calendar"></i> In the past month</h3>
            <% categorizedFiles.pastMonth.forEach(file=> { %>
              <%- include('file-item.ejs', { file }) %>
            <% }) %>
          <% } %>
  </div>

<% } else { %>

    <!-- Empty State -->
    <div class="empty-state">
      <div class="empty-state-content">
        <i class="ph-duotone ph-clock-counter-clockwise empty-icon"></i>
        <p>No recent activity.</p>
      </div>
    </div>

<% } %>