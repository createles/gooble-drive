<div id="uploadModal" class="modal-overlay modal"> 
  <div class="modal-content upload-modal-content"> 
    <div class="modal-header-tabs"> 
      <button class="tab-btn active" id="tabUpload" type="button"><i class="ph-duotone ph-cloud-arrow-up"></i> Upload File</button>
      <button class="tab-btn inactive" id="tabFolder" type="button"><i class="ph-duotone ph-folder-plus"></i> New Folder</button>
      <button class="close-modal" id="closeUploadModal" aria-label="Close modal" type="button"><i class="ph-duotone ph-x"></i></button>
    </div>

    <!-- Drag and Drop Upload Form -->
    <div id="formUploadCont">
      <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-form">
        <div class="upload-dropzone" id="dropzone">
          <i class="ph-duotone ph-cloud-arrow-up dropzone-icon"></i>
          <span class="dropzone-text">Drag & drop files here, or <strong class="dropzone-browse">browse</strong></span>
          <input type="file" name="file" id="file" required class="dropzone-file-input">
          <span class="selected-file-name" id="selectedFileName"></span>
        </div>
        <input type="hidden" name="parentId" value="<%= locals.currentFolder ? currentFolder.id : '' %>">
        <button type="submit" class="btn-primary btn-upload"><i class="ph-duotone ph-upload-simple"></i> Upload File</button>
      </form>
    </div>

    <!-- New Folder Form -->
    <div id="formFolderCont" style="display: none;">
      <form action="/folders/create" method="POST" class="upload-form">
        <div class="form-group">
          <label for="folderName">Folder Name</label>
          <input type="text" name="name" id="folderName" placeholder="e.g. Work Documents" required>
        </div>
        <input type="hidden" name="parentId" value="<%= locals.currentFolder ? currentFolder.id : '' %>">
        <button type="submit" class="btn-primary btn-upload"><i class="ph-duotone ph-folder-plus"></i> Create Folder</button>
      </form>
    </div>
  </div>
</div>