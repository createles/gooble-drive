<div class="breadcrumbs">
  <a href="/dashboard/starred" class="breadcrumb-link"><i class="ph-duotone ph-star"></i> Starred Items</a>
</div>

<!-- Conditional Rendering based on database contents -->
<% if ((locals.folders && folders.length > 0) || (locals.files && files.length > 0)) { %>

  <div class="item-grid">
    <!-- Loop over folders -->
    <% folders.forEach(folder=> { %>
      <%- include('folder-item.ejs', { folder }) %>
    <% }) %>

    <!-- Loop over files -->
    <% files.forEach(file=> { %>
      <%- include('file-item.ejs', { file }) %>
    <% }) %>
  </div>

<% } else { %>

    <!-- Empty State -->
    <div class="empty-state">
      <div class="empty-state-content">
        <i class="ph-duotone ph-star empty-icon"></i>
        <p>No starred files or folders.</p>
      </div>
    </div>

<% } %>