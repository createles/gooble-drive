<div id="deleteModal" class="modal-overlay">
  <div class="modal-content">
    <h3><i class="ph-duotone ph-trash"></i> Delete <span id="deleteItemType">item</span></h3>
    <p>Are you sure you want to delete this <span id="deleteItemName" style="font-weight: bold;">item</span>?</p>
    <div class="modal-buttons" style="margin-top: 1.5rem;">
      <button type="button" id="closeDeleteModal" class="btn-secondary">Cancel</button>
      <button type="button" id="confirmDeleteBtn" class="btn-primary" style="background-color: var(--danger, #ef4444); color: white;">Delete</button>
    </div>
  </div>
</div>
