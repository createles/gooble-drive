<div id="renameModal" class="modal-overlay">
  <div class="modal-content">
    <h3><i class="ph-duotone ph-pencil-simple"></i> Rename <span id="renameItemType">item</span></h3>
    <form id="renameForm">
      <input type="text" id="renameInput" class="text-input" placeholder="Enter new name" required style="width: 100%; padding: 0.8rem; margin: 1rem 0; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 1rem; background: var(--bg-primary); color: var(--text-main);">
      <div class="modal-buttons">
        <button type="button" id="closeRenameModal" class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-primary">Rename</button>
      </div>
    </form>
  </div>
</div>
