<div id="tutorialOverlay" class="tutorial-overlay"></div>

<div id="tutorialModal" class="tutorial-modal">
  <button type="button" class="tutorial-close-btn" id="cancelTutorial" aria-label="Close tour"><i class="ph-duotone ph-x"></i></button>
  
  <div class="tutorial-content">
    <h3 id="tutorialTitle"></h3>
    <p id="tutorialMessage"></p>
  </div>

  <div class="tutorial-actions">
    <span id="tutorialStepCount">1 / 7</span>
    <button type="button" class="btn-primary" id="nextTutorialStep">Next</button>
  </div>
</div>