<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gobble Drive - <%= title %></title>
  <script>
    (function() {
      const savedTheme = localStorage.getItem('gobble_theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = savedTheme || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@400;500;600;700&family=Shantell+Sans:wght@700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link rel="stylesheet" href="/style.css"> 
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
</head>
<body class="auth-page">

  <div class="top-theme-toggle">
    <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle light/dark theme" title="Toggle theme">
      <i class="ph-duotone ph-sun theme-icon-light"></i>
      <i class="ph-duotone ph-moon theme-icon-dark"></i>
    </button>
  </div>

  <%- include('partials/notif-message.ejs') %>

  <div class="sign-up-cont auth-card">
    <div class="auth-brand">
      <img src="/logo-icons/Gobble_Drive_Transparent.svg" alt="Gobble Drive Logo" class="auth-logo-nav">
    </div>
    <h1>Create an Account</h1>
    <p class="auth-subtitle">Join Gobble Drive today.</p>

    <form action="/signup" method="POST">
      <label for="username">
        Username
        <input type="text" name="username" placeholder="Enter a username..." required>
      </label>

      <label for="password">
        Password
        <input type="password" name="password" required placeholder="Choose a strong password...">
      </label>

      <label for="confirm-password">
        Confirm Password
        <input type="password" name="confirm-password" required placeholder="Confirm your password...">
      </label>

      <button type="submit" class="btn-primary auth-submit-btn">
        <i class="ph-duotone ph-user-plus"></i> Sign Up
      </button>
    </form>
    
    <div class="auth-footer">
      <a href="/login" class="auth-link">Already have an account? Log in</a>
    </div>
  </div>
  
  <script src="/scripts/theme.js"></script>
</body>
</html>