<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gooble Drive - <%= title %></title>
  <link rel="stylesheet" href="/style.css"> 
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
</head>
<body>
  
  <section class="hero-banner">
    <img src="/gooble_drive_logo.svg" alt="Logo" style="width: 200px; height: 200px;">
    <h1
      style="display: flex; align-items: center; justify-content: center; gap: 1rem; font-size: 3rem; color: var(--primary-color); margin-bottom: 0.5rem;">
      Gooble Drive
    </h1>
    <h3 style="color: var(--text-muted); margin-bottom: 2rem;">Need storage? We'll gooble up your files for you.</h3>
    
    <a href="/signup" class="btn-upload" style="display: inline-block; text-decoration: none;">Get Started for Free</a>
  </section>

  <div class="members-login">
    <p style="color: var(--text-muted); margin-bottom: 0.5rem;">Already a member?</p>
    <a href="/login" style="color: var(--primary-color); font-weight: 600;">Log in to your dashboard</a>
  </div>

</body>
</html>